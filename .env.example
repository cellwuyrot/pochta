# === SMTP Service Configuration ===

# Domain name / hostname of THIS sending server (used for HELO, Message-ID,
# SPF/A resolution). Use a real hostname you control, e.g. mail.example.com.
SMTP_DOMAIN=mail.example.com

# SMTP server port (receiving, use 25 on VPS with root)
SMTP_PORT=2525

# Web admin panel port
WEB_PORT=3005
# Manual launch stays on localhost; Docker sets WEB_HOST=0.0.0.0 internally.
WEB_HOST=127.0.0.1
SMTP_HOST_PORT=587

# Admin credentials (used only to seed the first admin on an empty database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# Secret key for session signing.
# MUST be a long random string. Generate one with:  openssl rand -hex 32
# If left empty, the app auto-generates and persists a key at data/.secret_key.
SECRET_KEY=

# Optional GLOBAL admin API key (Authorization: Bearer <key>).
# Note: authentication is ALWAYS required. Each Site also gets its own key in
# the admin panel; this global key is an extra admin-scoped key. Leaving it
# empty does NOT disable auth.
API_KEY=

# Database path
DATABASE_URL=sqlite+aiosqlite:///./data/smtp.db

# TLS certificate paths — REQUIRED to enable SMTP AUTH (STARTTLS). Without
# them, authenticated relay over SMTP is refused so credentials never travel
# in cleartext.
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- Hardening knobs ---
# Send the Secure flag on the session cookie (needs HTTPS in front of the app).
# Set to false ONLY for local http:// development.
COOKIE_SECURE=true
# Expose Swagger UI at /api/docs (off by default).
API_DOCS_ENABLED=false
# Persist raw email bodies (incl. OTP codes) in the logs table (off by default).
STORE_BODY_PREVIEW=false
# Per-IP rate limits (requests per minute).
RATE_LIMIT_API_PER_MIN=60
RATE_LIMIT_LOGIN_PER_MIN=10

# --- Webhooks ---
# Per-request timeout when POSTing an event to a subscriber URL.
WEBHOOK_TIMEOUT_SECONDS=10
# Attempts per delivery before it is marked failed (backoff 10s/1m/5m/30m).
WEBHOOK_MAX_ATTEMPTS=5
# How often the background dispatcher looks for due deliveries.
WEBHOOK_POLL_INTERVAL_SECONDS=5
# Deliveries sent concurrently per tick.
WEBHOOK_CONCURRENCY=5
# Allow webhook URLs on loopback/private/link-local addresses. Off by default:
# a site API key would otherwise let someone aim the server at internal services
# or cloud metadata (169.254.169.254). Turn on for local development.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Require https:// for subscriber URLs.
WEBHOOK_REQUIRE_HTTPS=true

# Relay SMTP settings (optional, for sending via external SMTP — recommended
# for best deliverability: Postmark, Amazon SES, Mailgun, Yandex, etc.)
RELAY_HOST=
RELAY_PORT=587
RELAY_USERNAME=
RELAY_PASSWORD=
RELAY_USE_TLS=true

# Outbound policy: relay-only by default. Explicit opt-in for direct MX.
ALLOW_DIRECT_MX=false
# Inbound reception is optional. When enabled, encrypted full MIME is stored.
INBOUND_ENABLED=false
SMTP_MAX_RECIPIENTS=50
SMTP_MAX_MESSAGE_BYTES=10485760
SMTP_ACCOUNT_PER_MIN=30
# Trust forwarded headers only from these socket peers; empty ignores XFF.
TRUSTED_PROXY_IPS=
# Comma-separated Fernet keys: primary first, old keys retained during rotation.
# If empty, generated data/.encryption_key MUST be backed up separately.
DATA_ENCRYPTION_KEYS=
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=7

# Private SMTP relays / non-standard ports: only explicit trusted local development.
SMTP_ALLOW_PRIVATE_TARGETS=false
