+{% extends "base.html" %}{% block title %}SMTP-провайдеры{% endblock %}{% block body %}
+<div class="layout">{% set active='providers' %}{% include 'nav.html' %}<main class="main">
+<p class="eyebrow">Доставка / Маршрутизация</p><div class="page-header"><h2>SMTP-провайдеры</h2><a class="btn btn-primary" href="/admin/providers/new">Добавить провайдера</a></div>
+<p class="muted">Первым используется активный провайдер с меньшим приоритетом. При отказе соединения — следующий маршрут.</p>
+<section class="section"><table class="providers-table"><thead><tr><th>Провайдер / сайт</th><th>Подключение</th><th>Приоритет</th><th>Проверка</th><th>Действия</th></tr></thead><tbody>
+{% for p in providers %}<tr><td><strong>{{ p.name }}</strong><br>{{ sites[p.site_id].domain if p.site_id in sites else 'Сайт удалён' }}<br><span class="badge">{{ 'Активен' if p.is_active else 'Отключён' }}</span></td><td>{{ p.host }}:{{ p.port }}<br><span class="muted">{{ 'Implicit TLS' if p.port==465 else ('STARTTLS' if p.use_tls else 'Без TLS') }}</span><br>{{ 'Пароль сохранён' if p.password else 'Без пароля' }}</td><td>{{ p.priority }}</td><td>{{ p.last_tested_at.strftime('%d.%m.%Y %H:%M') if p.last_tested_at else 'Не проверен' }}<br>{{ 'Соединение установлено' if p.last_test_ok else p.last_test_error }}<br><span class="muted">Тест подключения ≠ доставка</span></td><td><div class="actions"><a class="btn btn-ghost" href="/admin/providers/{{ p.id }}/edit">Изменить</a>{% for action,label in [('test','Проверить'),('primary','Основной'),('toggle','Переключить'),('delete','Удалить')] %}<form method="post" action="/admin/providers/{{ p.id }}/{{ action }}" {% if action=='delete' %}data-confirm="Удалить провайдера?"{% endif %}>
+<input type="hidden" name="csrf_token" value="{{ request.state.csrf_token }}"><button class="btn {{ 'btn-danger' if action=='delete' else 'btn-ghost' }}" type="submit">{{ label }}</button></form>{% endfor %}</div></td></tr>{% else %}<tr><td colspan="5">Провайдеров пока нет. Добавьте SMTP relay для отправки.</td></tr>{% endfor %}
+</tbody></table></section><section class="section"><h3>Эффективный порядок</h3>{% for id, labels in orders.items() %}<p><strong>{{ sites[id].domain }}</strong> — {{ ' → '.join(labels) if labels else ('Direct MX (включён явно)' if direct_mx else 'Отправка запрещена: нет relay') }}</p>{% endfor %}</section>
+</main></div>{% endblock %}
