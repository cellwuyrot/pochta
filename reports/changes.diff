+{% extends "base.html" %}{% block body %}<div class="layout">{% set active='queue' %}{% include 'nav.html' %}<main class="main"><p class="eyebrow">Исходящая почта / Outbox</p><div class="page-header"><h2>Очередь сообщений</h2><span class="muted">{{ total }} заданий</span></div><p class="muted">Accepted — письмо принято SMTP relay, а не доставлено в почтовый ящик. Unknown — нужен разбор на стороне relay; автоматического повтора нет.</p><form method="get" class="filters"><div class="form-group"><label>Статус</label><select name="state">{% for value in ['', 'queued','sending','accepted','failed','unknown'] %}<option value="{{ value }}" {% if state==value %}selected{% endif %}>{{ value or 'Все статусы' }}</option>{% endfor %}</select></div><button class="btn" type="submit">Показать</button></form><section class="section"><table><thead><tr><th>ID / дата (UTC)</th><th>Статус</th><th>Попытки</th><th>Relay</th><th>Ошибка</th></tr></thead><tbody>{% for job in jobs %}<tr><td><a href="/admin/messages/{{ job.id }}">{{ job.id }}</a><br>{{ job.created_at }}</td><td><span class="badge">{{ job.status }}</span></td><td>{{ job.attempts }}</td><td>{{ job.relay or '—' }}</td><td>{{ job.error or '—' }}</td></tr>{% else %}<tr><td colspan="5">Очередь пуста</td></tr>{% endfor %}</tbody></table></section><div class="pagination">{% if page>1 %}<a href="?page={{ page-1 }}&state={{ state }}">Назад</a>{% endif %}{% if total>page*50 %}<a href="?page={{ page+1 }}&state={{ state }}">Далее</a>{% endif %}</div></main></div>{% endblock %}
